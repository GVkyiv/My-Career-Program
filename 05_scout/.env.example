# Скопировать в .env и заполнить. .env в git не попадает (см. .gitignore).

# Gmail-адрес и app password (НЕ обычный пароль от Google).
# Создаётся тут: https://myaccount.google.com/apppasswords
# Нужна включённая двухфакторка. Пароль из 16 символов, пробелы можно оставить.
GMAIL_USER=genadiy.kiev@gmail.com
GMAIL_APP_PASSWORD=

# Ключ Claude API: https://console.anthropic.com/settings/keys
# Без него скрипт работает, но скоринг будет только по ключевым словам.
ANTHROPIC_API_KEY=
